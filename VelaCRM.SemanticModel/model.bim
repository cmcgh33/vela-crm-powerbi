        ],
        "lineageTag": "b406c3f3-a499-4b0b-8e3c-a71f95c0d102",
        "measures": [
          {
            "name": "Won ACV",
            "description": "Won ACV; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Sales performance",
            "expression": "CALCULATE(SUM(Opportunities[ACV]), Opportunities[Status] = \"Won\")",
            "formatString": "$#,0;($#,0);$0",
            "lineageTag": "686ed4e9-3749-429b-a7df-5eb43c2d3819"
          },
          {
            "name": "Won Deals",
            "description": "Won Deals; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Sales performance",
            "expression": "CALCULATE(COUNTROWS(Opportunities), Opportunities[Status] = \"Won\")",
            "formatString": "#,0",
            "lineageTag": "a296557e-04b2-491d-8223-185d1b5c931b"
          },
          {
            "name": "Lost Deals",
            "description": "Lost Deals; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Sales performance",
            "expression": "CALCULATE(COUNTROWS(Opportunities), Opportunities[Status] = \"Lost\")",
            "formatString": "#,0",
            "lineageTag": "58a93cf1-070a-424e-9f0b-6eb4e3e6cce4"
          },
          {
            "name": "Closed Deals",
            "description": "Closed Deals; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Sales performance",
            "expression": "[Won Deals] + [Lost Deals]",
            "formatString": "#,0",
            "lineageTag": "f9a795c2-8083-4f4e-a8e3-e6ca63d8157b"
          },
          {
            "name": "Win Rate",
            "description": "Win Rate; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Sales performance",
            "expression": "DIVIDE([Won Deals], [Closed Deals])",
            "formatString": "0.0%",
            "lineageTag": "7b58b121-7e5f-45a4-bd20-4a74652c5318"
          },
          {
            "name": "Average Won ACV",
            "description": "Average Won ACV; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Sales performance",
            "expression": "DIVIDE([Won ACV], [Won Deals])",
            "formatString": "$#,0",
            "lineageTag": "3de46e09-0733-44b8-969e-8c2f55f640db"
          },
          {
            "name": "Average Sales Cycle",
            "description": "Average Sales Cycle; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Sales performance",
            "expression": "CALCULATE(AVERAGE(Opportunities[SalesCycleDays]), Opportunities[Status] = \"Won\")",
            "formatString": "0.0\" days\"",
            "lineageTag": "1d073681-9966-4092-be49-661a36adbaf1"
          },
          {
            "name": "Open Pipeline ACV",
            "description": "Open Pipeline ACV; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Pipeline snapshot",
            "expression": "CALCULATE(SUM(Opportunities[ACV]), REMOVEFILTERS('Date'), Opportunities[Status] = \"Open\")",
            "formatString": "$#,0",
            "lineageTag": "73719c2f-ee01-44a9-bb3e-035b9e78862d"
          },
          {
            "name": "Weighted Pipeline ACV",
            "description": "Weighted Pipeline ACV; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Pipeline snapshot",
            "expression": "CALCULATE(SUMX(Opportunities, Opportunities[ACV] * Opportunities[Probability]), REMOVEFILTERS('Date'), Opportunities[Status] = \"Open\")",
            "formatString": "$#,0",
            "lineageTag": "72e0f5fa-3d07-45a0-974b-5831b0d43d5c"
          },
          {
            "name": "Open Deals",
            "description": "Open Deals; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Pipeline snapshot",
            "expression": "CALCULATE(COUNTROWS(Opportunities), REMOVEFILTERS('Date'), Opportunities[Status] = \"Open\")",
            "formatString": "#,0",
            "lineageTag": "80525df7-c5da-4c24-bd6e-e84fbf40cf20"
          },
          {
            "name": "At Risk Pipeline ACV",
            "description": "At Risk Pipeline ACV; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Pipeline snapshot",
            "expression": "CALCULATE([Open Pipeline ACV], Opportunities[IsAtRisk] = 1)",
            "formatString": "$#,0",
            "lineageTag": "697423d5-5350-4780-b489-a4bba3184299"
          },
          {
            "name": "At Risk Deals",
            "description": "At Risk Deals; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Pipeline snapshot",
            "expression": "CALCULATE([Open Deals], Opportunities[IsAtRisk] = 1)",
            "formatString": "#,0",
            "lineageTag": "457583f5-dbf1-4baf-8550-7a27dc5a12ce"
          },
          {
            "name": "Overdue Deals",
            "description": "Overdue Deals; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Pipeline snapshot",
            "expression": "CALCULATE([Open Deals], Opportunities[IsOverdue] = 1)",
            "formatString": "#,0",
            "lineageTag": "941e3d3b-a1e5-4131-b0a5-391ef0f0fe06"
          },
          {
            "name": "Target ACV",
            "description": "Target ACV; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Sales performance",
            "expression": "IF(ISCROSSFILTERED(Accounts) || ISFILTERED(Opportunities[LeadSource]) || ISFILTERED(Opportunities[Product]) || ISCROSSFILTERED(Stages), BLANK(), CALCULATE(SUM(Targets[TargetACV]), KEEPFILTERS('Date'[Date] <= DATE(2026, 9, 30))))",
            "formatString": "$#,0",
            "lineageTag": "b5322341-be53-4724-88c9-c54f34e7f3db"
          },
          {
            "name": "Target Attainment",
            "description": "Target Attainment; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Sales performance",
            "expression": "DIVIDE([Won ACV], [Target ACV])",
            "formatString": "0.0%",
            "lineageTag": "70d9662b-fe09-47ba-bf38-f5fce2822355"
          },
          {
            "name": "Won ACV Prior Year",
            "description": "Won ACV Prior Year; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Sales performance",
            "expression": "CALCULATE([Won ACV], DATEADD('Date'[Date], -1, YEAR))",
            "formatString": "$#,0",
            "lineageTag": "b1b0507e-8f89-4cf5-8900-0937bb3caaec"
          },
          {
            "name": "Won ACV YoY",
            "description": "Won ACV YoY; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Sales performance",
            "expression": "DIVIDE([Won ACV] - [Won ACV Prior Year], [Won ACV Prior Year])",
            "formatString": "0.0%",
            "lineageTag": "e4566d13-b837-44fd-996d-6453d10b1059"
          },
          {
            "name": "Pipeline Risk Share",
            "description": "Pipeline Risk Share; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Pipeline snapshot",
            "expression": "DIVIDE([At Risk Pipeline ACV], [Open Pipeline ACV])",
            "formatString": "0.0%",
            "lineageTag": "694a0820-8748-48df-801c-e16c0ca0689f"
          },
          {
            "name": "Average Current Stage Age",
            "description": "Average Current Stage Age; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Pipeline snapshot",
            "expression": "CALCULATE(AVERAGE(Opportunities[DaysInStage]), REMOVEFILTERS('Date'), Opportunities[Status] = \"Open\")",
            "formatString": "0.0\" days\"",
            "lineageTag": "3ca889ec-ebf2-4b9c-b387-0db1cf40ae19"
          },
          {
            "name": "Accounts in Context",
            "description": "Accounts in Context; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Sales performance",
            "expression": "DISTINCTCOUNT(Opportunities[AccountID])",
            "formatString": "#,0",
            "lineageTag": "24f3f868-02fd-4ad1-bcbb-b6e4f69091e4"
          },
          {
            "name": "Snapshot Label",
            "description": "Snapshot Label; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Pipeline snapshot",
            "expression": "\"Pipeline snapshot · 30 Sep 2026\"",
            "lineageTag": "3bd7ee35-d4fd-44a0-87d7-333d0e0a2c0e"
          },
          {
            "name": "Stage Reached Deals",
            "description": "Stage Reached Deals; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Sales performance",
            "expression": "VAR Cohort = CALCULATETABLE(VALUES(Opportunities[OpportunityID]), CROSSFILTER('Date'[Date], Opportunities[CloseDate], NONE), USERELATIONSHIP('Date'[Date], Opportunities[CreatedDate]), REMOVEFILTERS(Stages)) RETURN CALCULATE(DISTINCTCOUNT('Stage History'[OpportunityID]), TREATAS(Cohort, 'Stage History'[OpportunityID]))",
            "formatString": "#,0",
            "lineageTag": "7a07db82-7959-4fcd-8d31-f9a30fc67ff9"
          },
          {
            "name": "Cohort Qualified Deals",
            "description": "Cohort Qualified Deals; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Sales performance",
            "expression": "CALCULATE([Stage Reached Deals], REMOVEFILTERS(Stages), Stages[StageID] = 1)",
            "formatString": "#,0",
            "lineageTag": "10690878-ebbd-40db-b6f2-2ce3b05e0420"
          },
          {
            "name": "Stage Reach Rate",
            "description": "Stage Reach Rate; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Sales performance",
            "expression": "DIVIDE([Stage Reached Deals], [Cohort Qualified Deals])",
            "formatString": "0.0%",
            "lineageTag": "dcbab0bf-8888-43e8-a85a-7bf62995927b"
          },
          {
            "name": "Average Completed Stage Days",
            "description": "Average Completed Stage Days; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Sales performance",
            "expression": "VAR Cohort = CALCULATETABLE(VALUES(Opportunities[OpportunityID]), CROSSFILTER('Date'[Date], Opportunities[CloseDate], NONE), USERELATIONSHIP('Date'[Date], Opportunities[CreatedDate]), REMOVEFILTERS(Stages)) RETURN CALCULATE(AVERAGE('Stage History'[DaysInStage]), TREATAS(Cohort, 'Stage History'[OpportunityID]), 'Stage History'[ExitedDate] <> BLANK())",
            "formatString": "0.0\" days\"",
            "lineageTag": "ff952d82-3729-43c1-be14-467c32ae789c"
          },
          {
            "name": "Last Activity Date",
            "description": "Last Activity Date; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Sales performance",
            "expression": "MAX(Activities[ActivityDate])",
            "formatString": "dd mmm yyyy",
            "lineageTag": "73cdc7e7-2979-4ef8-8c56-adb645eddd91"
          },
          {
            "name": "Attention Deal ACV",
            "description": "Attention Deal ACV; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Sales performance",
            "expression": "CALCULATE(SUM(Opportunities[ACV]), REMOVEFILTERS('Date'), Opportunities[Status] = \"Open\", Opportunities[IsAtRisk] = 1)",
            "formatString": "$#,0",
            "lineageTag": "cf73b1d6-5a3f-43d7-9ac7-3c4cb5e6724f"
          },
          {
            "name": "Cohort Deals",
            "description": "Cohort Deals; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Sales performance",
            "expression": "CALCULATE(COUNTROWS(Opportunities), CROSSFILTER('Date'[Date], Opportunities[CloseDate], NONE), USERELATIONSHIP('Date'[Date], Opportunities[CreatedDate]), REMOVEFILTERS(Stages))",
            "formatString": "#,0",
            "lineageTag": "8d135a00-7333-493f-9847-6b9d0c749f76"
          },
          {
            "name": "Gauge Minimum",
            "description": "Gauge Minimum; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Sales performance",
            "expression": "0",
            "formatString": "0%",
            "lineageTag": "e50c0522-8bac-417c-8162-f5e0125aeeb6"
          },
          {
            "name": "Gauge Maximum",
            "description": "Gauge Maximum; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Sales performance",
            "expression": "MAX(1.5, [Target Attainment] * 1.15)",
            "formatString": "0%",
            "lineageTag": "77a13269-1fd3-4cad-b26c-86a98601d262"
          },
          {
            "name": "Gauge Target",
            "description": "Gauge Target; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Sales performance",
            "expression": "1",
            "formatString": "0%",
            "lineageTag": "a8f16e4e-16be-46b9-aeb2-b03e12efd2fb"
          },
          {
            "name": "Pipeline by Risk Band",
            "description": "Pipeline by Risk Band; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Pipeline snapshot",
            "expression": "VAR Flag = SELECTEDVALUE('Risk Bands'[RiskID]) RETURN IF(NOT ISBLANK(Flag), CALCULATE([Open Pipeline ACV], Opportunities[IsAtRisk] = Flag))",
            "formatString": "$#,0",
            "lineageTag": "d4426f5a-ecd1-4e4c-b7ed-18965665f38d"
          },
          {
            "name": "Source Outcome Flow SVG",
            "dataCategory": "ImageUrl",
            "description": "Source Outcome Flow SVG; see docs/metric-definitions.md for date and denominator rules.",
            "displayFolder": "Sales performance",
            "expression": [
              "VAR Sources = DATATABLE(\"SourceName\", STRING, \"I\", INTEGER, \"C\", STRING, {{\"Partner\",0,\"#26D9EA\"},{\"Inbound\",1,\"#4785FF\"},{\"Outbound\",2,\"#A875FF\"},{\"Event\",3,\"#F85BA5\"}})",
              "VAR Outcomes = DATATABLE(\"Outcome\", STRING, \"J\", INTEGER, \"D\", STRING, {{\"Won\",0,\"#26D9EA\"},{\"Lost\",1,\"#F85BA5\"},{\"Open\",2,\"#FFBD59\"}})",
              "VAR Total = [Cohort Deals]",
              "VAR Scale = DIVIDE(200, Total, 0)",
              "VAR Links = CONCATENATEX(Sources,",
              " VAR S = [SourceName] VAR SI = [I] VAR SC = [C]",
              " RETURN CONCATENATEX(Outcomes,",
              "  VAR O = [Outcome] VAR OI = [J] VAR OC = [D]",
              "  VAR N = CALCULATE([Cohort Deals], Opportunities[LeadSource] = S, Opportunities[Status] = O)",
              "  VAR PriorS = SUMX(FILTER(Outcomes, [J] < OI), VAR PO = [Outcome] RETURN CALCULATE([Cohort Deals], Opportunities[LeadSource] = S, Opportunities[Status] = PO))",
              "  VAR PriorO = SUMX(FILTER(Sources, [I] < SI), VAR PS = [SourceName] RETURN CALCULATE([Cohort Deals], Opportunities[LeadSource] = PS, Opportunities[Status] = O))",
              "  VAR SY = 24 + SI * 24 + SUMX(FILTER(Sources, [I] < SI), VAR PS = [SourceName] RETURN CALCULATE([Cohort Deals], Opportunities[LeadSource] = PS)) * Scale + (PriorS + N / 2) * Scale",
              "  VAR DY = 35 + OI * 35 + SUMX(FILTER(Outcomes, [J] < OI), VAR PO = [Outcome] RETURN CALCULATE([Cohort Deals], Opportunities[Status] = PO)) * Scale + (PriorO + N / 2) * Scale",
              "  VAR W = N * Scale",
              "  RETURN IF(N > 0, \"<defs><linearGradient id='g\" & SI & OI & \"'><stop stop-color='\" & SC & \"'/><stop offset='1' stop-color='\" & OC & \"'/></linearGradient></defs><path d='M 192 \" & FORMAT(SY,\"0.00\",\"en-US\") & \" C 415 \" & FORMAT(SY,\"0.00\",\"en-US\") & \" 585 \" & FORMAT(DY,\"0.00\",\"en-US\") & \" 808 \" & FORMAT(DY,\"0.00\",\"en-US\") & \"' fill='none' stroke='url(#g\" & SI & OI & \")' stroke-opacity='0.58' stroke-width='\" & FORMAT(W,\"0.00\",\"en-US\") & \"'/>\", \"\"), \"\"), \"\")",
              "VAR LeftNodes = CONCATENATEX(Sources,",
              " VAR S = [SourceName] VAR SI = [I] VAR SC = [C]",
              " VAR N = CALCULATE([Cohort Deals], Opportunities[LeadSource] = S)",
              " VAR Y = 24 + SI * 24 + SUMX(FILTER(Sources, [I] < SI), VAR PS = [SourceName] RETURN CALCULATE([Cohort Deals], Opportunities[LeadSource] = PS)) * Scale",
              " RETURN IF(N > 0, \"<rect x='14' y='\" & Y & \"' width='178' height='\" & FORMAT(N*Scale,\"0.00\",\"en-US\") & \"' rx='8' fill='\" & SC & \"'/><text x='28' y='\" & (Y+19) & \"' font-size='20' font-weight='600' fill='#070A18'>\" & S & \" · \" & FORMAT(N,\"#,0\") & \"</text>\", \"\"), \"\")",
              "VAR RightNodes = CONCATENATEX(Outcomes,",
              " VAR O = [Outcome] VAR OI = [J] VAR OC = [D]",
              " VAR N = CALCULATE([Cohort Deals], Opportunities[Status] = O)",
              " VAR Y = 35 + OI * 35 + SUMX(FILTER(Outcomes, [J] < OI), VAR PO = [Outcome] RETURN CALCULATE([Cohort Deals], Opportunities[Status] = PO)) * Scale",
              " RETURN IF(N > 0, \"<rect x='808' y='\" & Y & \"' width='178' height='\" & FORMAT(N*Scale,\"0.00\",\"en-US\") & \"' rx='8' fill='\" & OC & \"'/><text x='822' y='\" & (Y+19) & \"' font-size='20' font-weight='600' fill='#070A18'>\" & O & \" · \" & FORMAT(N,\"#,0\") & \"</text>\", \"\"), \"\")",
              "VAR Svg = \"<svg xmlns='http://www.w3.org/2000/svg' width='1000' height='340' viewBox='0 0 1000 340'><rect width='1000' height='340' fill='#11152A'/><g font-family='Segoe UI'>\" & Links & LeftNodes & RightNodes & \"</g></svg>\"",
              "RETURN IF(Total > 0, \"data:image/svg+xml;utf8,\" & SUBSTITUTE(Svg,\"#\",\"%23\"))"
            ],
            "lineageTag": "68afef66-1389-49aa-9e48-48886e45be98"
          }
        ],
